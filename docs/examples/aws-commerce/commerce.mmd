---
config:
  theme: base
  look: classic
  fontFamily: Inter, Helvetica, Arial, sans-serif
  flowchart:
    curve: linear
    nodeSpacing: 28
    rankSpacing: 44
    padding: 14
    wrappingWidth: 280
    htmlLabels: true
  themeVariables:
    fontSize: 14px
    lineColor: "#545B64"
    primaryTextColor: "#000000"
    edgeLabelBackground: "#FFFFFF"
    clusterBkg: transparent
  themeCSS: >-
    .nodeLabel span{font-size:12px;color:#334155}
---
flowchart LR
  accTitle: L2 Services -- Adobe Commerce on AWS
  accDescr: Route 53 resolves shoppers to CloudFront behind AWS WAF. A public load balancer spreads requests over Varnish, an internal one over the Magento servers, which use OpenSearch, ElastiCache for Redis, Aurora and EFS across two Availability Zones.
  users@{ icon: "aws:res-users", label: "Shoppers", pos: "b", h: 48 }
  subgraph cloud["AWS Cloud"]
    r53@{ icon: "aws:amazon-route-53", label: "Amazon Route 53", pos: "b", h: 80 }
    waf@{ icon: "aws:aws-waf", label: "AWS WAF", pos: "b", h: 80 }
    cf@{ icon: "aws:amazon-cloudfront", label: "Amazon CloudFront", pos: "b", h: 80 }
    subgraph region["Region"]
      subgraph vpc["VPC"]
        alb@{ icon: "aws:res-elastic-load-balancing-application-load-balancer", label: "Public Application Load Balancer", pos: "b", h: 48 }
        ialb@{ icon: "aws:res-elastic-load-balancing-application-load-balancer", label: "Internal Application Load Balancer", pos: "b", h: 48 }
        search@{ icon: "aws:amazon-opensearch-service", label: "Amazon OpenSearch Service<br/>catalog search", pos: "b", h: 80 }
        redis@{ icon: "aws:res-amazon-elasticache-elasticache-for-redis", label: "ElastiCache for Redis<br/>sessions and query cache", pos: "b", h: 48 }
        efs@{ icon: "aws:amazon-efs", label: "Amazon EFS<br/>shared content", pos: "b", h: 80 }
        subgraph az1["Availability Zone 1"]
          varnish1@{ icon: "aws:res-amazon-ec2-instances", label: "Varnish Cache", pos: "b", h: 48 }
          magento1@{ icon: "aws:res-amazon-ec2-instances", label: "Magento", pos: "b", h: 48 }
          aurora1@{ icon: "aws:amazon-aurora", label: "Aurora primary", pos: "b", h: 80 }
        end
        subgraph az2["Availability Zone 2"]
          varnish2@{ icon: "aws:res-amazon-ec2-instances", label: "Varnish Cache", pos: "b", h: 48 }
          magento2@{ icon: "aws:res-amazon-ec2-instances", label: "Magento", pos: "b", h: 48 }
          aurora2@{ icon: "aws:amazon-aurora", label: "Aurora standby", pos: "b", h: 80 }
        end
      end
    end
  end
  users -->|"1"| r53
  r53 --> cf
  waf -->|"2"| cf
  cf -->|"3"| alb
  alb -->|"4"| varnish1
  alb --> varnish2
  varnish1 -->|"5"| ialb
  varnish2 --> ialb
  ialb -->|"6"| magento1
  ialb --> magento2
  magento1 -->|"8"| search
  magento1 -->|"9"| redis
  magento1 -->|"10"| aurora1
  magento2 --> aurora1
  magento1 -->|"11"| efs
  aurora1 -.-> aurora2
  classDef ingest fill:#FFFFFF,stroke:#0E8A7D,stroke-width:3px,color:#0F172A
  classDef xform fill:#FFFFFF,stroke:#7B4FB0,stroke-width:3px,color:#0F172A
  classDef load fill:#FFFFFF,stroke:#0072B2,stroke-width:3px,color:#0F172A
