  themeCSS: >-
    .nodeLabel span{font-size:12px;color:#334155}
---
flowchart LR
  accTitle: L2 Services -- Adobe Commerce on AWS, application tier
  accDescr: The internal load balancer spreads requests over Magento in two Availability Zones. Magento uses OpenSearch, ElastiCache for Redis, Aurora and EFS, and Aurora keeps its standby in the second zone.
  subgraph cloud["AWS Cloud"]
    subgraph region["Region"]
      subgraph vpc["VPC"]
        ialb@{ icon: "aws:res-elastic-load-balancing-application-load-balancer", label: "Internal load balancer", pos: "b", h: 48 }
        search@{ icon: "aws:amazon-opensearch-service", label: "Amazon OpenSearch Service<br/>catalog search", pos: "b", h: 80 }
        redis@{ icon: "aws:res-amazon-elasticache-elasticache-for-redis", label: "ElastiCache for Redis<br/>sessions and query cache", pos: "b", h: 48 }
        efs@{ icon: "aws:amazon-efs", label: "Amazon EFS<br/>shared content", pos: "b", h: 80 }
        subgraph az["Availability Zones x2"]
          magento@{ icon: "aws:res-amazon-ec2-instances", label: "Magento<br/>Auto Scaling group", pos: "b", h: 48 }
          aurora@{ icon: "aws:amazon-aurora", label: "Aurora<br/>primary and standby", pos: "b", h: 80 }
        end
      end
    end
  end
  ialb -->|"5"| magento
  magento -->|"6"| search
  magento -->|"7"| redis
  magento -->|"8"| aurora
  magento -->|"9"| efs
  classDef ingest fill:#FFFFFF,stroke:#0E8A7D,stroke-width:3px,color:#0F172A
