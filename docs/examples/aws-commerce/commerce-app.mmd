config:
  theme: base
  look: classic
  fontFamily: Inter, Helvetica, Arial, sans-serif
  flowchart:
    curve: linear
    nodeSpacing: 28
    rankSpacing: 44
    padding: 14
    wrappingWidth: 280
    htmlLabels: true
  themeVariables:
    fontSize: 14px
    lineColor: "#545B64"
    primaryTextColor: "#000000"
